import redis

r = redis.Redis()

# Cache user embeddings (updated daily)
# Key: user_emb:{user_id}
# Value: serialized embedding (128 floats)
# TTL: 24 hours
# Size: ~500 bytes per user × 1M users = 500GB (OK)

# Cache trending products (updated hourly)
# Key: trending:{category}:{region}
# Value: list of top 20 product IDs
# TTL: 1 hour

